  metadata      Json?
  created_at    DateTime  @default(now())
  profiles      profiles? @relation(fields: [actor_user_id], references: [id])

  @@index([entity_type, entity_id])
  @@schema("public")
}

model categories {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain_id String    @db.Uuid
  name      String
  slug      String    @unique
  domains   domains   @relation(fields: [domain_id], references: [id])
  content   content[]

  @@index([domain_id])
  @@schema("public")
}

model content {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_type_id String                  @db.Uuid
  category_id     String?                 @db.Uuid
  domain_id       String                  @db.Uuid
  title           String
  description     String?
  body            Json?
  media_path      String?
  is_published    Boolean                 @default(false)
  created_by      String?                 @db.Uuid
  created_at      DateTime                @default(now())
  updated_at      DateTime
  categories      categories?             @relation(fields: [category_id], references: [id])
  content_types   content_types           @relation(fields: [content_type_id], references: [id])
  profiles        profiles?               @relation(fields: [created_by], references: [id])
  domains         domains                 @relation(fields: [domain_id], references: [id])
  content_prerequisites_content_prerequisites_content_idTocontent              content_prerequisites[] @relation("content_prerequisites_content_idTocontent")
  content_prerequisites_content_prerequisites_prerequisite_content_idTocontent content_prerequisites[] @relation("content_prerequisites_prerequisite_content_idTocontent")
  content_versions                                                             content_versions[]
  user_content_progress                                                        user_content_progress[]

  @@index([category_id])
  @@index([content_type_id])
  @@index([domain_id])
  @@schema("public")
}

model content_prerequisites {
  id                      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id              String  @db.Uuid
  prerequisite_content_id String  @db.Uuid
  content_content_prerequisites_content_idTocontent              content @relation("content_prerequisites_content_idTocontent", fields: [content_id], references: [id])
  content_content_prerequisites_prerequisite_content_idTocontent content @relation("content_prerequisites_prerequisite_content_idTocontent", fields: [prerequisite_content_id], references: [id])

  @@unique([content_id, prerequisite_content_id])
  @@index([prerequisite_content_id])
  @@schema("public")
}

model content_types {
  id      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key     String    @unique
  label   String
  content content[]

  @@schema("public")
}

model content_versions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id     String    @db.Uuid
  version_number Int
  body_snapshot  Json
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now())
  content        content   @relation(fields: [content_id], references: [id])
  profiles       profiles? @relation(fields: [created_by], references: [id])

  @@unique([content_id, version_number])
  @@index([content_id])
  @@schema("public")
}

model domains {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  categories  categories[]
  content     content[]
  tracks      tracks[]

  @@schema("public")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String             @unique
  description      String?
  role_permissions role_permissions[]

  @@schema("public")
}

model profiles {
  id                    String                  @id @db.Uuid
  full_name             String?
  avatar_url            String?
  created_at            DateTime                @default(now())
  updated_at            DateTime
  users                 users                   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audit_logs            audit_logs[]
  content               content[]
  content_versions      content_versions[]
  user_content_progress user_content_progress[]
  user_roles            user_roles[]
  user_tracks           user_tracks[]

  @@schema("public")
}

model progress_status {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                   String                  @unique
  label                 String
  user_content_progress user_content_progress[]

  @@schema("public")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id])
  roles         roles       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@schema("public")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique
  description      String?
  role_permissions role_permissions[]
  user_roles       user_roles[]

  @@schema("public")
}

model tracks {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain_id   String        @db.Uuid
  full_label  String
  short_label String
  slug        String        @unique
  description String?
  sort_order  Int           @default(0)
  domains     domains       @relation(fields: [domain_id], references: [id])
  user_tracks user_tracks[]

  @@index([domain_id])
  @@schema("public")
}

model user_content_progress {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String          @db.Uuid
  content_id         String          @db.Uuid
  status_id          String          @db.Uuid
  progress_percent   Int             @default(0)
  started_at         DateTime?
  completed_at       DateTime?
  last_interacted_at DateTime?
  content            content         @relation(fields: [content_id], references: [id])
  progress_status    progress_status @relation(fields: [status_id], references: [id])
  profiles           profiles        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id])
  @@index([user_id])
  @@schema("public")
}

model user_roles {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String   @db.Uuid
  role_id  String   @db.Uuid
  org_id   String?
  roles    roles    @relation(fields: [role_id], references: [id])
  profiles profiles @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, org_id])
  @@index([user_id])
  @@schema("public")
}

model user_tracks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  track_id   String    @db.Uuid
  is_primary Boolean   @default(false)
  status     String    @default("active")
  started_at DateTime  @default(now())
  ended_at   DateTime?
  tracks     tracks    @relation(fields: [track_id], references: [id])
  profiles   profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([track_id])
  @@index([user_id])
  @@schema("public")
}

