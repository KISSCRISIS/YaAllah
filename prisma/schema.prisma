// =============================================================================
// SEG Prisma Schema — UUID Edition
// =============================================================================
// SEG Phase 0.3A-13 — Auth Boundary Hardened
//
// ⚠️  GOVERNANCE — READ BEFORE MODIFYING
// ─────────────────────────────────────────────────────────────────
// • Prisma OWNS:     public.* (16 tables — schema, migrations, seed)
// • Supabase OWNS:   auth.*   (managed exclusively by Supabase Auth)
// • BOUNDARY:        profiles.id → auth.users.id (FK, READ-ONLY)
//
// The `users` model below is a REFLECTION ONLY of auth.users.
// It exists solely so Prisma can understand the FK relationship
// with public.profiles.  Do NOT use `prisma.users` for writes
// under any circumstances — Supabase Auth is the single writer.
//
// ALL other auth.* models and enums are @@ignore'd.
// Removing @@ignore from any auth model requires governance approval.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

// =============================================================================
// AUTH SCHEMA — Supabase-managed (REFERENCE ONLY)
// =============================================================================

/// ╔══════════════════════════════════════════════════════════════╗
/// ║  READ-ONLY — Managed exclusively by Supabase Auth.         ║
/// ║  DO NOT use prisma.users.create / update / delete.         ║
/// ║  All user mutations MUST go through Supabase Auth client.  ║
/// ║  This model exists only to satisfy the FK:                 ║
/// ║    public.profiles.id → auth.users.id (ON DELETE CASCADE)  ║
/// ╚══════════════════════════════════════════════════════════════╝
model users {
  id        String    @id @db.Uuid
  profiles  profiles?

  @@schema("auth")
}

